{
  "schema_version": 1,
  "abilities": {
    "状态边界": {
      "agreed": true,
      "description": "区分隔离、待检、未判废、已合格、放行与可领用等状态。"
    },
    "时间边界": {
      "agreed": true,
      "description": "按被问时点可见的材料判断，不用后出结论回填当时状态。"
    },
    "例外范围": {
      "agreed": true,
      "description": "识别例外条款明确指向的对象、工位、封签或回执，不扩大到其他批次。"
    }
  },
  "rules": {
    "R-NEUTRAL-DISPOSITION": {
      "text": "“未判废”“未判不合格”只排除了一种负面结论，不推出合格、放行或可领用。",
      "misread_code": "NEGATIVE_DISPOSITION_AS_POSITIVE"
    },
    "R-PENDING-ISOLATION": {
      "text": "已隔离且报告/合格结论未到时，物料仍处于待检控制，不能按六盒全部可领处理。"
    },
    "R-AS-OF": {
      "text": "历史时点判断只可使用该时点已经可见的结论；之后形成的合格结论只能作对照，不能回填。"
    },
    "R-NAMED-EXCEPTION": {
      "text": "“除某对象外”“仅某对象”的例外只覆盖文字明确点名的范围，不能扩及同批其他对象或另一批次。",
      "misread_code": "EXCEPTION_SCOPE_EXPANDED"
    },
    "R-SEAL-TYPE": {
      "text": "解除运输封不等于解除待检标志；一个动作只改变它明确对应的控制。",
      "misread_code": "PARTIAL_RELEASE_OVERGENERALIZED"
    },
    "R-RECEIPT-VS-PROCESS": {
      "text": "完成送检或检验过程不等于持有带号合格回执；回执主体以“仅”后明确记载为准。",
      "misread_code": "PROCESS_STATUS_AS_QUALIFIED_EVIDENCE"
    },
    "R-PICKUP-EMBARGO": {
      "text": "已判合格或交回隔离钥匙不自动产生即时领用权；明确的验收后等待/提领限制仍须遵守。",
      "misread_code": "QUALIFIED_AS_IMMEDIATE_PICKUP"
    }
  },
  "misread_codes": {
    "NEGATIVE_DISPOSITION_AS_POSITIVE": "把未判废/未判不合格误读成可领或已放行",
    "LATER_RECORD_BACKDATED": "把时点之后才出现的结论当成当时已知",
    "EXCEPTION_SCOPE_EXPANDED": "把点名例外扩大到未点名对象或另一批",
    "EXCEPTION_WRONG_BATCH": "把一句例外套用到另一批/另一工位",
    "PARTIAL_RELEASE_OVERGENERALIZED": "把运输封解除误读成待检状态解除",
    "PROCESS_STATUS_AS_QUALIFIED_EVIDENCE": "把已送检/完成送检误读成已有合格回执",
    "QUALIFIED_AS_IMMEDIATE_PICKUP": "把合格误读成不受提领时间限制"
  },
